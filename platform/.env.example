# ============================================
# Go Platform Layer 配置文件
# Go Platform Layer Configuration
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# Copy this file to .env and modify according to your environment

# ============================================
# 服务器配置 | Server Configuration
# ============================================
# 平台服务监听端口 | Platform service port
PLATFORM_PORT=:8080

# ============================================
# AI Runtime 连接配置 | AI Runtime Connection
# ============================================
# AI Runtime gRPC 服务地址 | AI Runtime gRPC service address
# 格式: host:port | Format: host:port
AI_RUNTIME_ADDR=localhost:50051

# ============================================
# JWT 认证配置 | JWT Authentication Configuration
# ============================================
# JWT 密钥（生产环境必须修改为强随机字符串！）
# JWT secret key (MUST change to a strong random string in production!)
JWT_SECRET=your-secret-key-change-this-in-production-use-strong-random-string

# Access Token 有效期（小时）| Access token TTL in hours
ACCESS_TOKEN_TTL=1

# Refresh Token 有效期（小时）| Refresh token TTL in hours
REFRESH_TOKEN_TTL=168

# ============================================
# PostgreSQL 数据库配置 | PostgreSQL Database Configuration
# ============================================
# 数据库主机地址 | Database host
POSTGRES_HOST=localhost

# 数据库端口 | Database port
POSTGRES_PORT=5432

# 数据库名称 | Database name
POSTGRES_DB=ai_platform

# 数据库用户名 | Database user
POSTGRES_USER=ai_platform

# 数据库密码 | Database password
POSTGRES_PASSWORD=19980912

# SSL 模式 | SSL mode (disable/require/verify-ca/verify-full)
POSTGRES_SSLMODE=disable

# 最大连接数 | Maximum connections
POSTGRES_MAX_CONNS=25

# 最小连接数 | Minimum connections
POSTGRES_MIN_CONNS=5

# ============================================
# Redis 缓存配置 | Redis Cache Configuration
# ============================================
# Redis 主机地址 | Redis host
REDIS_HOST=localhost

# Redis 端口 | Redis port
REDIS_PORT=6379

# Redis 密码（如果没有密码则留空）| Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis 数据库编号 | Redis database number
REDIS_DB=0

# Redis 连接池大小 | Redis pool size
REDIS_POOL_SIZE=10

# ============================================
# Elasticsearch 配置 | Elasticsearch Configuration
# ============================================
# Elasticsearch 服务地址 | Elasticsearch URL
ELASTICSEARCH_URL=http://localhost:9200

# Elasticsearch 用户名（如果需要认证）| Elasticsearch username (if authentication required)
ELASTICSEARCH_USERNAME=

# Elasticsearch 密码（如果需要认证）| Elasticsearch password (if authentication required)
ELASTICSEARCH_PASSWORD=

# ============================================
# 限流配置 | Rate Limiting Configuration
# ============================================
# 每分钟最大请求数 | Maximum requests per minute
RATE_LIMIT_REQUESTS=100

# 限流时间窗口（秒）| Rate limit window in seconds
RATE_LIMIT_WINDOW=60

# ============================================
# 日志配置 | Logging Configuration
# ============================================
# 日志级别 | Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 是否启用详细日志 | Enable verbose logging
LOG_VERBOSE=false

# ============================================
# 环境配置 | Environment Configuration
# ============================================
# 运行环境 | Environment (development/staging/production)
ENVIRONMENT=development

# ============================================
# 功能开关 | Feature Flags
# ============================================
# 是否启用 RAG 功能 | Enable RAG feature
ENABLE_RAG=true

# 是否启用 Agent 功能 | Enable Agent feature
ENABLE_AGENT=true

# 是否启用遥测 | Enable telemetry
ENABLE_TELEMETRY=false

# 是否启用审计日志 | Enable audit logging
ENABLE_AUDIT_LOG=true

# ============================================
# CORS 配置 | CORS Configuration
# ============================================
# 允许的源（多个用逗号分隔）| Allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# 是否允许凭证 | Allow credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================
# 性能配置 | Performance Configuration
# ============================================
# HTTP 请求超时（秒）| HTTP request timeout in seconds
HTTP_TIMEOUT=30

# gRPC 连接超时（秒）| gRPC connection timeout in seconds
GRPC_TIMEOUT=10

# 最大请求体大小（MB）| Maximum request body size in MB
MAX_REQUEST_BODY_SIZE=10