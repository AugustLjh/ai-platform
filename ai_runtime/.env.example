# ============================================
# AI Runtime 配置文件
# AI Runtime Configuration
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# Copy this file to .env and modify according to your environment

# ============================================
# 数据库配置 | Database Configuration
# ============================================
# PostgreSQL 主机地址 | PostgreSQL host
POSTGRES_HOST=localhost

# PostgreSQL 端口 | PostgreSQL port
POSTGRES_PORT=5432

# 数据库名称 | Database name
POSTGRES_DB=ai_platform

# 数据库用户名 | Database user
POSTGRES_USER=ai_platform

# 数据库密码 | Database password
POSTGRES_PASSWORD=19980912

# SSL 模式 | SSL mode (disable/require/verify-ca/verify-full)
POSTGRES_SSLMODE=disable

# 最大连接数 | Maximum connections
POSTGRES_MAX_CONNS=25

# 最小连接数 | Minimum connections
POSTGRES_MIN_CONNS=5

# ============================================
# 嵌入模型配置 | Embedding Model Configuration
# ============================================
# 嵌入服务提供商 | Embedding provider
# 可选项 | Options:
#   - local: 本地模型（需要下载，占用内存，但免费）
#   - openai: OpenAI API（在线服务，需要API密钥）
#   - jina: Jina AI API（在线服务，免费额度大，推荐）
EMBEDDING_PROVIDER=jina

# ===== 在线服务配置（provider=openai/jina 时需要）=====
# API 密钥 | API key for online embedding services
# OpenAI: 从 https://platform.openai.com/api-keys 获取
# Jina AI: 从 https://jina.ai/ 获取（免费额度：100万tokens/月）
EMBEDDING_API_KEY=your-api-key-here

# API 基础 URL（可选）| API base URL (optional, for proxy)
# EMBEDDING_API_BASE=https://api.openai.com/v1

# ===== 模型选择 | Model Selection =====
# 根据 provider 选择对应的模型 | Choose model based on provider:

# 如果 provider=openai:
#   - text-embedding-3-small (1536维，性价比高，推荐)
#   - text-embedding-3-large (3072维，质量更好)
#   - text-embedding-ada-002 (1536维，旧版本)

# 如果 provider=jina:
#   - jina-embeddings-v3 (1024维，多语言，推荐)
#   - jina-embeddings-v2-base-zh (768维，中文优化)

# 如果 provider=local:
#   - paraphrase-multilingual-MiniLM-L12-v2 (384维，多语言，推荐)
#   - paraphrase-multilingual-mpnet-base-v2 (768维，质量更好)
#   - all-MiniLM-L6-v2 (384维，仅英文，更快)

EMBEDDING_MODEL=jina-embeddings-v3

# ===== 本地模型配置（仅 provider=local 时需要）=====
# 嵌入模型运行设备 | Device for local embedding model (cpu/cuda)
EMBEDDING_DEVICE=cpu

# 模型缓存目录（可选）| Model cache folder (optional)
# 如果不设置，将使用默认缓存目录
# If not set, will use default cache directory
# EMBEDDING_CACHE_FOLDER=/path/to/cache

# ============================================
# 配额配置 | Quota Configuration
# ============================================
# 每个租户最大文档数 | Maximum documents per tenant
MAX_DOCUMENTS_PER_TENANT=10000

# 单个文档最大大小（字节）| Maximum document size in bytes
# 默认: 10MB = 10485760 bytes
MAX_DOCUMENT_SIZE=10485760

# 上传文件最大大小（字节）| Maximum upload file size in bytes
# 默认: 20MB = 20971520 bytes
MAX_UPLOAD_FILE_SIZE=20971520

# ============================================
# 向量搜索配置 | Vector Search Configuration
# ============================================
# 是否使用 pgvector 扩展（需要在 PostgreSQL 中启用）
# Use pgvector extension for better performance
# 需要执行: CREATE EXTENSION vector; 在 PostgreSQL 中
# Requires: CREATE EXTENSION vector; in PostgreSQL
USE_PGVECTOR=false

# 向量搜索返回的最大结果数 | Maximum results for vector search
VECTOR_SEARCH_TOP_K=5

# 向量相似度阈值（0-1）| Vector similarity threshold (0-1)
VECTOR_SIMILARITY_THRESHOLD=0.7

# ============================================
# 服务器配置 | Server Configuration
# ============================================
# 服务器监听地址 | Server host
SERVER_HOST=0.0.0.0

# HTTP 服务端口 | HTTP port
HTTP_PORT=8000

# gRPC 服务端口 | gRPC port
GRPC_PORT=50051

# ============================================
# LLM 配置 | LLM Configuration
# ============================================
# LLM 提供商 | LLM provider (openai/local/mock)
LLM_PROVIDER=mock

# OpenAI API 密钥（如果使用 OpenAI）| OpenAI API key (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI 模型名称 | OpenAI model name
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI API 基础 URL（可选，用于代理）| OpenAI API base URL (optional, for proxy)
# OPENAI_API_BASE=https://api.openai.com/v1

# LLM 请求超时（秒）| LLM request timeout in seconds
LLM_TIMEOUT=30

# LLM 最大重试次数 | LLM maximum retries
LLM_MAX_RETRIES=3

# ============================================
# RAG 配置 | RAG Configuration
# ============================================
# RAG 检索的文档数量 | Number of documents to retrieve for RAG
RAG_TOP_K=5

# RAG 上下文最大长度（tokens）| Maximum context length for RAG in tokens
RAG_MAX_CONTEXT_LENGTH=2000

# 是否启用 RAG 重排序 | Enable RAG reranking
RAG_ENABLE_RERANKING=false

# ============================================
# Agent 配置 | Agent Configuration
# ============================================
# Agent 最大迭代次数 | Maximum iterations for agent
AGENT_MAX_ITERATIONS=10

# Agent 超时时间（秒）| Agent timeout in seconds
AGENT_TIMEOUT=60

# 是否启用工具调用日志 | Enable tool call logging
AGENT_LOG_TOOL_CALLS=true

# ============================================
# 功能开关 | Feature Flags
# ============================================
# 是否启用审计日志 | Enable audit logging
ENABLE_AUDIT_LOG=true

# 是否启用性能监控 | Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=false

# 是否启用调试模式 | Enable debug mode
ENABLE_DEBUG=false

# ============================================
# 环境配置 | Environment Configuration
# ============================================
# 运行环境 | Environment (development/staging/production)
# 生产环境请设置为 'production'
# Set to 'production' in production environment
ENVIRONMENT=development

# ============================================
# 日志配置 | Logging Configuration
# ============================================
# 日志级别 | Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 日志格式 | Log format (json/text)
LOG_FORMAT=text

# 是否输出到文件 | Output to file
LOG_TO_FILE=false

# 日志文件路径（如果启用文件输出）| Log file path (if file output enabled)
# LOG_FILE_PATH=/var/log/ai_runtime.log

# ============================================
# 缓存配置 | Cache Configuration
# ============================================
# Redis 主机地址（用于缓存）| Redis host (for caching)
REDIS_HOST=localhost

# Redis 端口 | Redis port
REDIS_PORT=6379

# Redis 密码（如果需要）| Redis password (if required)
REDIS_PASSWORD=

# Redis 数据库编号 | Redis database number
REDIS_DB=0

# 缓存过期时间（秒）| Cache expiration time in seconds
CACHE_TTL=3600

# ============================================
# 性能配置 | Performance Configuration
# ============================================
# 工作进程数（0 表示自动检测 CPU 核心数）| Number of workers (0 for auto-detect CPU cores)
WORKERS=0

# 每个工作进程的线程数 | Threads per worker
THREADS_PER_WORKER=1

# 请求队列大小 | Request queue size
REQUEST_QUEUE_SIZE=100

# ============================================
# 安全配置 | Security Configuration
# ============================================
# 是否启用 API 密钥认证 | Enable API key authentication
ENABLE_API_KEY_AUTH=false

# API 密钥（如果启用）| API key (if enabled)
# API_KEY=your-api-key-here

# 是否启用 CORS | Enable CORS
ENABLE_CORS=true

# 允许的源（多个用逗号分隔）| Allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=*

# ============================================
# 监控配置 | Monitoring Configuration
# ============================================
# Prometheus 指标端口 | Prometheus metrics port
# METRICS_PORT=9090

# 是否启用健康检查端点 | Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# 健康检查路径 | Health check path
HEALTH_CHECK_PATH=/health