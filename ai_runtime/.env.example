# AI Runtime Environment Configuration
# Copy this file to .env and configure your settings

# ===== Database Configuration =====
POSTGRES_HOST=192.168.147.41
POSTGRES_PORT=5432
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=19980912
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# ===== Embedding Model Configuration =====
# Model name from sentence-transformers
# Options:
#   - paraphrase-multilingual-MiniLM-L12-v2 (recommended, 384 dim, multilingual)
#   - paraphrase-multilingual-mpnet-base-v2 (768 dim, better quality)
#   - all-MiniLM-L6-v2 (384 dim, English only, faster)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Device to use for embedding (cpu/cuda)
EMBEDDING_DEVICE=cpu

# Model cache folder (optional)
# EMBEDDING_CACHE_FOLDER=/path/to/cache

# ===== Quota Configuration =====
MAX_DOCUMENTS_PER_TENANT=10000
MAX_DOCUMENT_SIZE=10485760  # 10MB in bytes
MAX_UPLOAD_FILE_SIZE=20971520  # 20MB in bytes

# ===== Vector Search Configuration =====
# Use pgvector extension for better performance
# Requires: CREATE EXTENSION vector; in PostgreSQL
USE_PGVECTOR=false

# ===== Server Configuration =====
SERVER_HOST=0.0.0.0
HTTP_PORT=8000
GRPC_PORT=50051

# ===== Features =====
# Enable audit logging
ENABLE_AUDIT_LOG=true

# ===== Development/Production Mode =====
# Set to 'production' in production environment
ENVIRONMENT=development

# ===== Logging =====
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
