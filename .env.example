# ============================================
# AI Platform 全局配置文件
# AI Platform Global Configuration
# ============================================
# 此文件用于 Docker Compose 部署时的全局配置
# This file is used for global configuration when deploying with Docker Compose
# 复制此文件为 .env 并根据实际情况修改配置
# Copy this file to .env and modify according to your environment

# ============================================
# JWT 认证配置 | JWT Authentication Configuration
# ============================================
# JWT 密钥（生产环境必须修改为强随机字符串！）
# JWT secret key (MUST change to a strong random string in production!)
# 建议使用: openssl rand -base64 32 生成
# Recommended: use `openssl rand -base64 32` to generate
JWT_SECRET=your-secret-key-change-this-in-production-use-strong-random-string

# ============================================
# PostgreSQL 数据库配置 | PostgreSQL Database Configuration
# ============================================
# 数据库主机地址 | Database host
# Docker Compose 中使用服务名: postgres
# Use service name in Docker Compose: postgres
POSTGRES_HOST=localhost

# 数据库端口 | Database port
POSTGRES_PORT=5432

# 数据库名称 | Database name
POSTGRES_DB=ai_platform

# 数据库用户名 | Database user
POSTGRES_USER=ai_platform

# 数据库密码 | Database password
# 生产环境请使用强密码！| Use strong password in production!
POSTGRES_PASSWORD=19980912

# SSL 模式 | SSL mode (disable/require/verify-ca/verify-full)
POSTGRES_SSLMODE=disable

# 最大连接数 | Maximum connections
POSTGRES_MAX_CONNS=25

# 最小连接数 | Minimum connections
POSTGRES_MIN_CONNS=5

# ============================================
# Redis 缓存配置 | Redis Cache Configuration
# ============================================
# Redis 主机地址 | Redis host
# Docker Compose 中使用服务名: redis
# Use service name in Docker Compose: redis
REDIS_HOST=localhost

# Redis 端口 | Redis port
REDIS_PORT=6379

# Redis 密码（如果没有密码则留空）| Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis 数据库编号 | Redis database number
REDIS_DB=0

# AI Runtime 配置 | AI Runtime Configuration
# ============================================
# AI Runtime gRPC 服务地址 | AI Runtime gRPC service address
# Docker Compose 中使用: ai-runtime:50051
# Use in Docker Compose: ai-runtime:50051
AI_RUNTIME_ADDR=localhost:50051

# Platform 服务端口 | Platform service port
PLATFORM_PORT=:8080

# ============================================
# OpenAI 配置（可选）| OpenAI Configuration (Optional)
# ============================================
# OpenAI API 密钥 | OpenAI API key
# 如果不使用 OpenAI，可以留空或使用 mock 模式
# If not using OpenAI, leave empty or use mock mode
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI 模型名称 | OpenAI model name
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI API 基础 URL（可选，用于代理）| OpenAI API base URL (optional, for proxy)
# OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# 应用配置 | Application Configuration
# ============================================
# 日志级别 | Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 运行环境 | Environment (development/staging/production)
ENVIRONMENT=development

# ============================================
# 功能开关 | Feature Flags
# ============================================
# 是否启用 RAG 功能 | Enable RAG feature
ENABLE_RAG=true

# 是否启用 Agent 功能 | Enable Agent feature
ENABLE_AGENT=true

# 是否启用遥测 | Enable telemetry
ENABLE_TELEMETRY=false

# 是否启用审计日志 | Enable audit logging
ENABLE_AUDIT_LOG=true

# ============================================
# Docker Compose 特定配置 | Docker Compose Specific Configuration
# ============================================
# 这些配置仅在使用 Docker Compose 时需要
# These configurations are only needed when using Docker Compose

# Docker 镜像标签 | Docker image tag
# IMAGE_TAG=latest

# Docker 网络名称 | Docker network name
# NETWORK_NAME=ai-platform

# 数据卷路径 | Volume paths
# POSTGRES_DATA_PATH=./data/postgres
# REDIS_DATA_PATH=./data/redis

# ============================================
# 前端配置 | Frontend Configuration
# ============================================
# 前端服务端口 | Frontend service port
FRONTEND_PORT=80

# API 基础 URL（前端使用）| API base URL (used by frontend)
# 在 Docker Compose 中，前端通过 Nginx 代理访问后端
# In Docker Compose, frontend accesses backend through Nginx proxy
API_BASE_URL=http://localhost:8080

# ============================================
# 监控和可观测性 | Monitoring and Observability
# ============================================
# ============================================
# 安全配置 | Security Configuration
# ============================================
# CORS 允许的源（多个用逗号分隔）| CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# 是否允许凭证 | Allow credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================
# 备份配置 | Backup Configuration
# ============================================
# 备份目录 | Backup directory
# BACKUP_DIR=./backups

# 备份保留天数 | Backup retention days
# BACKUP_RETENTION_DAYS=7

# ============================================
# 开发配置 | Development Configuration
# ============================================
# 是否启用热重载 | Enable hot reload
# DEV_HOT_RELOAD=true

# 是否启用调试模式 | Enable debug mode
# DEV_DEBUG=true

# 是否启用详细日志 | Enable verbose logging
# DEV_VERBOSE=true

# ============================================
# SSL/TLS 证书配置 | SSL/TLS Certificate Configuration
# ============================================
# 域名（用于 Let's Encrypt 证书）| Domain name (for Let's Encrypt certificate)
DOMAIN=yourdomain.com

# 管理员邮箱（用于 Let's Encrypt 通知）| Admin email (for Let's Encrypt notifications)
EMAIL=admin@yourdomain.com

# Let's Encrypt 测试模式 | Let's Encrypt staging mode
# 设置为 1 使用测试服务器（避免触发速率限制）| Set to 1 to use staging server (avoid rate limits)
# 设置为 0 使用生产服务器 | Set to 0 to use production server
LETSENCRYPT_STAGING=0
